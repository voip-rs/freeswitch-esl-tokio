#!/bin/bash
# Pre-commit hook: Cargo.lock placement, fmt, clippy, doc coverage, tests, source sync

set -e

# Cargo.lock belongs only on the detached commit a release tag points at, so a
# release build resolves an exact dependency set while master stays a library
# workspace with the lock gitignored. Detached HEAD is the whole signal: on a
# branch, staging it is always the "forgot to git checkout --detach" mistake.
if git diff --cached --name-only --diff-filter=AM | grep -qx 'Cargo.lock'; then
    if git symbolic-ref -q HEAD >/dev/null; then
        echo "❌ Cargo.lock is staged on branch $(git symbolic-ref --short HEAD)."
        echo "It may only be committed on the release tag's own detached commit."
        echo "Run 'git checkout --detach' first, then stage and commit it."
        exit 1
    fi
fi

# Prefer .gitleaks.local.toml when present — it extends the committed
# .gitleaks.toml with operator identifiers we do not commit. --staged scans
# the diff about to land; a history scan would miss it.
gitleaks_config=".gitleaks.toml"
if [ -f ".gitleaks.local.toml" ]; then
    gitleaks_config=".gitleaks.local.toml"
fi
if ! gitleaks git --staged --config "$gitleaks_config" --no-banner -v --log-level error; then
    echo "❌ gitleaks found secrets in staged changes. Fix them before committing."
    exit 1
fi

if ! scripts/fmt-workspace.sh -- --check; then
    echo "❌ Code is not formatted. Run 'scripts/fmt-workspace.sh' to fix."
    exit 1
fi

# --all-features throughout: sdp and conference-info are off by default, so
# without it a whole module compiles, lints and tests nowhere.
if ! cargo clippy --quiet --workspace --all-features --all-targets --message-format=short -- -D warnings; then
    echo "❌ Clippy found warnings. Fix them before committing."
    exit 1
fi

if ! doc_output=$(RUSTDOCFLAGS="-D missing_docs -D rustdoc::broken_intra_doc_links" cargo doc --workspace --all-features --no-deps 2>&1); then
    echo "$doc_output" | grep -E '^error|^\s*= (note|help):' | head -20
    echo "❌ Documentation errors. Run: RUSTDOCFLAGS='-D missing_docs -D rustdoc::broken_intra_doc_links' cargo doc --workspace --all-features --no-deps"
    exit 1
fi

# Debug build: the oracle's default case count is left to pre-release.sh and CI.
if ! test_output=$(PROPTEST_CASES="${PROPTEST_CASES:-4096}" cargo test --workspace --all-features 2>&1); then
    if echo "$test_output" | grep -q '^failures:'; then
        echo "$test_output" | sed -n '/^failures:/,$p'
    else
        # No `failures:` section means cargo test never reached the run phase
        # (a build error) -- fall back to the tail so that isn't swallowed.
        echo "$test_output" | tail -40
    fi
    echo "❌ Tests failed. Fix them before committing."
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if ! python3 "$SCRIPT_DIR/check-enums.py" --quiet; then
    echo "❌ Enum coverage out of sync with FreeSWITCH. Run: python3 hooks/check-enums.py"
    exit 1
fi

if ! python3 "$SCRIPT_DIR/check-source-refs.py" --quiet; then
    echo "❌ Source references out of sync. Run: python3 hooks/check-source-refs.py"
    exit 1
fi
